# Kopiuj ten plik jako .env.local do developmentu lokalnego.
# Na Vercel ta zmienna jest już ustawiona w ustawieniach projektu — nie
# trzeba jej tam dodawać ręcznie.

# Klucz API z panelu Resend (Settings → API Keys).
# Używany wyłącznie po stronie serwera w app/api/contact/route.ts —
# nigdy nie trafia do kodu wysyłanego do przeglądarki.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
